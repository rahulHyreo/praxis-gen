# Dependencies
node_modules
.pnp
.pnp.js
.pnpm-store

# Local env files.
#
# Root /.env is an optional host-mode fallback, read by packages/db/src/env.ts
# (dotenv, override: false) so a plain `pnpm dev` on the host can find a
# database. Nothing generates it.
#
# docker/env/.env is the third, OPTIONAL layer of the committed env stack
# (docker/env/README.md): base.env -> local.env -> .env, later wins. It is the
# only place a real secret may live. The first two layers are committed and
# carry non-secret, localhost-only values; this one never is.
/.env
.env.local
.env.development.local
.env.test.local
.env.production.local
docker/env/.env

# Testing
coverage

# Turbo
.turbo

# Build outputs
dist

# Debug
npm-debug.log*

# Misc
.DS_Store
*.pem

# Later changes add their own entries here as they introduce the tools that
# produce them (Playwright reports, load-test output, CI scratch, and so on).
# Keeping this file to what the repository actually generates means an entry
# here is evidence that something writes that path.
