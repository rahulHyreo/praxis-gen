    },
    "open_history_claim_6": {
      "label": "Open claim detail — history claim 6",
      "latencyMs": 200,
      "writes": {},
      "completesStepId": ["step_006", "step_009"]
    },
    "open_history_claim_7": {
      "label": "Open claim detail — history claim 7",
      "latencyMs": 200,
      "writes": {},
      "completesStepId": ["step_006", "step_009"]
    }
  },
  "persistence": {
    "persistKey": null,
    "autosave": false,
    "resetOnSubmit": false
  }
}
