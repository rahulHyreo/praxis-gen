{
  "$schema": "training-platform/v1/flow-state",
  "$version": "1.0.0",
  "id": "state_rb2_1_secondary_policy_cob_split",
  "initial": {
    "defaultActiveTabId": "tab_event_resolution",
    "defaultActiveSubTabIds": {
      "tab_search": "subtab_search_claims",
      "tab_claim_data": "subtab_claim_data_details",
      "tab_attachment": "subtab_attachment_attachments"
    },
    "defaultCollapsedSections": {},
    "defaultDecision": "",
    "decisionRequired": false
  },
  "modeConfig": {
    "training": {
      "id": "training",
      "label": "Training mode",
      "badgeIcon": "graduation-cap",
      "showNavigator": true,
      "timerType": "count_up",
      "timerPosition": "navigator_header",
      "timeLockEnabled": false,
      "showHints": true,
      "showMarkCompleteButton": true,
      "allowTabClose": true
    },
    "practice": {
      "id": "practice",
      "label": "Practice mode",
      "badgeIcon": "dumbbell",
      "showNavigator": false,
      "timerType": "count_up",
      "timerPosition": "topbar",
      "timeLockEnabled": false,
      "showHints": false,
      "showMarkCompleteButton": false,
      "allowTabClose": true
    },
    "assessment": {
      "id": "assessment",
      "label": "Assessment Mode",
      "badgeIcon": "graduation-cap",
      "showNavigator": false,
      "timerType": "count_down",
      "timerPosition": "topbar_right",
      "timeLimitSeconds": 600,
      "timeLockEnabled": true,
      "showHints": false,
      "showMarkCompleteButton": false,
      "allowTabClose": false,
      "beforeUnloadWarning": "Assessment in progress. Leaving will lose your progress."
    }
  },
  "actions": {
    "claims_search": {
      "label": "Search claim history",
      "latencyMs": 300,
      "writes": {
        "search.claimsSearched": true
      },
      "completesStepId": "step_003"
    },
    "claims_search_clear": {
      "label": "Clear the claim search criteria",
      "latencyMs": 0,
      "writes": {
        "search.claims.subscriberOrHcid": "",
        "search.claimsSearched": false
      }
    },
    "open_primary_claim": {
      "label": "Open the primary claim's processing detail",
      "latencyMs": 200,
      "writes": {},
      "completesStepId": "step_005"
    },
    "open_cob_worksheet": {
      "label": "Open the COB worksheet",
      "latencyMs": 300,
      "writes": {},
      "completesStepId": "step_007"
    },
    "submit_cob_worksheet": {
      "label": "Submit — apply the coordinated values to the claim lines",
      "latencyMs": 400,
      "writes": {
        "claimLineSummary.providerDiscount": "$92.70",
        "claimLineSummary.providerDiscountEob": "00128",
        "claimLineSummary.paidAmount": "$2.43",
        "claimLineSummary.deductibleAmount": "—",
        "claimLineSummary.copayAmount": "$10.00",
        "claimLineSummary.copayEob": "00135",
        "claimLineSummary.coinsuranceAmount": "—",
        "claimLineSummary.noncoveredAmount": "$111.87",
        "claimLineSummary.noncoveredEob": "00159",
        "claimLineSummary.allowed": "$124.30",
        "claimLineSummary.payment": "$2.43",
        "header.claimAllowed": "$124.30",
        "header.paid": "$2.43",
        "header.copay": "$10.00",
        "header.writeOff": "$92.70",
        "cobWorksheet.status": "The coordinated values have been applied to the Claim Lines tab."
      },
      "completesStepId": "step_008"
    }
  },
  "persistence": {
    "persistKey": null,
    "autosave": false,
    "resetOnSubmit": false
  }
}
