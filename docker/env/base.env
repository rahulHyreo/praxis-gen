# Base environment configuration (committed).
# Non-secret defaults shared by every environment. See ./README.md.
#
# NOTHING HERE AUTHENTICATES TO ANYTHING OUTSIDE YOUR MACHINE. v1's copy of
# this file carries a live Azure storage account key and its own README says
# "treat repo read access as production root access". v2 does not inherit that:
# anything that authenticates off-box lives only in the gitignored .env layer,
# and this change introduces no such value.

# ----- Host port mappings -----
# A BLOCK DISTINCT FROM V1'S, so both stacks can run on one machine. This is
# the separation that matters most locally: a name collision fails loudly,
# whereas a port collision either refuses to start or — when you point psql,
# Drizzle Studio or a .env at localhost:5432 — silently attaches you to v1's
# database. During migration v1 is the system of record, so that is a
# data-loss path, not an inconvenience.
#
# In-container ports are unchanged, which leaves docs/SPEC.md §Layout's
# host-process ports (api 3001, web 5173) free for a plain `pnpm dev`
# alongside the containers.
#
#   service          v2     v1
#   Postgres         5433   5432
#   api              3002   3001
#   web              5174   8080
#   Drizzle Studio   4984   4983
#   MinIO            9010   9000
#   MinIO console    9011   9001
#   Redis            6380   6379
#   Bun inspector    6500   —
#
# NOTE: no trailing `#` comments on the assignments below. Docker's env_file
# parser and load-env.sh both take EVERYTHING after `=` as the value, so
# `POSTGRES_PORT=5433 # the port` yields the literal string "5433 # the port".
# This file was briefly written that way and the port tests caught it.
POSTGRES_PORT=5433
API_PORT=3002
WEB_PORT=5174
STUDIO_PORT=4984
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
REDIS_PORT=6380
INSPECT_PORT=6500

# ----- Object storage (MinIO) -----
# In-network endpoint — the compose service name. The local overlay also sets
# this on the api container; the value lives here so ad-hoc scripts agree.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Trainee-facing media: anonymous-read, served unsigned (§10).
S3_PUBLIC_BUCKET=praxis2-public
# Authored domain-pack content (§5, §42), which `pnpm packs:sync` publishes
# here. Server-side access only; never presigned to the browser.
#
# This supersedes v1's flows bucket: a pack is more than its flows (it carries
# modules, glossary, decision vocabulary and exam blueprints too), so the name
# follows the unit of configuration rather than one of its parts. The old
# variable name appears nowhere in this repository — see docker/README.md.
S3_PACKS_BUCKET=praxis2-packs
# Proctoring recordings (§25). Private.
S3_BUCKET=praxis2-proctoring

# ----- Redis (shared API response cache) -----
# In-network endpoint, same convention as S3_ENDPOINT. UNSET this (or set it
# empty) to turn caching off entirely: every cache call becomes a no-op. That
# is why a plain `pnpm dev` and the test suites, which never set it, need no
# Redis at all.
#
# A password belongs IN the URL — ioredis takes credentials from the URL, not
# from a separate variable. Empty locally, so the two agree trivially.
REDIS_URL=redis://redis:6379
# Namespace for every key this stack writes. Keeps v1 and v2 from reading or
# evicting each other's cached responses even pointed at one instance — those
# entries hold whole API payloads keyed by user, so a collision would be a
# cross-stack data leak, not just a stale read.
REDIS_KEY_PREFIX=praxis2:
# Lifetime of a cached entry. Short by design: it is the staleness ceiling for
# anything a mutation fails to invalidate, not a performance knob.
CACHE_TTL_SECONDS=60
# Memory ceiling for the container; on reaching it, cold entries are evicted
# (allkeys-lru) rather than the container being OOM-killed.
REDIS_MAXMEMORY=256mb
# Empty = no auth, which suits a container that is not reachable off-box.
REDIS_PASSWORD=

# ----- Database connection pool -----
# Per-process pool size (packages/db/src/client.ts; default 10 when unset).
# One api process locally, so 10 is ample. A topology that multiplies
# processes must keep API_REPLICAS x DB_POOL_MAX under Postgres's
# max_connections (the image default is 100).
DB_POOL_MAX=10

# ----- NO DISPLAY TIME ZONE -----
# Deliberately absent. docs/SPEC.md §7 [changed] makes the display time zone
# per market and per cohort, resolved by the application — v1 fixed it to
# Asia/Kolkata. An environment-level default here would be a second, competing
# source of truth that silently wins for anything that forgets to ask.
