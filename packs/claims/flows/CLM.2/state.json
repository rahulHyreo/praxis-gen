{
  "$schema": "training-platform/v1/flow-state",
  "$version": "1.0.0",
  "id": "state_clm_2_ll_review_spi_clm_not_applicable",
  "initial": {
    "defaultActiveTabId": "tab_event_resolution",
    "defaultActiveSubTabIds": {
      "tab_search": "subtab_search_benefits",
      "tab_claim_data": "subtab_claim_data_details",
      "tab_attachment": "subtab_attachment_attachments"
    },
    "defaultCollapsedSections": {},
    "defaultDecision": ""
  },
  "modeConfig": {
    "training": {
      "id": "training",
      "label": "Training mode",
      "badgeIcon": "graduation-cap",
      "showNavigator": true,
      "timerType": "count_up",
      "timerPosition": "navigator_header",
      "timeLockEnabled": false,
      "showHints": true,
      "showMarkCompleteButton": true,
      "allowTabClose": true
    },
    "practice": {
      "id": "practice",
      "label": "Practice mode",
      "badgeIcon": "dumbbell",
      "showNavigator": false,
      "timerType": "count_up",
      "timerPosition": "topbar",
      "timeLockEnabled": false,
      "showHints": false,
      "showMarkCompleteButton": false,
      "allowTabClose": true
    },
    "assessment": {
      "id": "assessment",
      "label": "Assessment Mode",
      "badgeIcon": "graduation-cap",
      "showNavigator": false,
      "timerType": "count_down",
      "timerPosition": "topbar_right",
      "timeLimitSeconds": 600,
      "timeLockEnabled": true,
      "showHints": false,
      "showMarkCompleteButton": false,
      "allowTabClose": false,
      "beforeUnloadWarning": "Assessment in progress. Leaving will lose your progress."
    }
  },
  "actions": {
    "validate": {
      "label": "Validate",
      "latencyMs": 400,
      "writes": {
        "eventResolution.bypassStatus": "Validated — PX_VA bypass applied to PX_CLM",
        "eventResolution.validationMessage": "PX_CLM BYPASSED — PX_VA ACCEPTED"
      },
      "completesStepId": "step_007",
      "guard": {
        "dataKey": "eventResolution.bypassCode",
        "equals": "PX_VA",
        "elseWrites": {
          "eventResolution.bypassStatus": "Bypass code not accepted for this event — review the bypass code and select again"
        }
      }
    },
    "open_ll_record_clm": {
      "label": "Open record — SPI-CLM 01/01/2026 – 03/31/2026",
      "latencyMs": 0,
      "writes": {
        "search.limitedLiability.selectedRecord.notes": "Deny Procedure 36415 as Not Medically necessary with rejection code PX_R23100",
        "search.limitedLiability.selectedRecord.status": "SPI-CLM record effective 01/01/2026 – 03/31/2026."
      },
      "completesStepId": "step_004"
    },
    "open_ll_record_clm_expired": {
      "label": "Open record — SPI-CLM 07/01/2025 – 12/31/2025",
      "latencyMs": 0,
      "writes": {
        "search.limitedLiability.selectedRecord.notes": "Deny Procedure 99213 as Not Medically necessary with rejection code PX_R23100",
        "search.limitedLiability.selectedRecord.status": "SPI-CLM record effective 07/01/2025 – 12/31/2025."
      }
    }
  },
  "persistence": {
    "persistKey": null,
    "autosave": false,
    "resetOnSubmit": false
  }
}
