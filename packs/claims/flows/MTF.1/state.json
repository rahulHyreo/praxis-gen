{
  "$schema": "training-platform/v1/flow-state",
  "$version": "1.0.0",
  "id": "state_mtf_1_within_tfl",
  "initial": {
    "defaultActiveTabId": "tab_notes",
    "defaultActiveSubTabIds": {
      "tab_search": "subtab_search_benefits",
      "tab_claim_data": "subtab_claim_data_details"
    },
    "defaultCollapsedSections": {},
    "defaultDecision": ""
  },
  "modeConfig": {
    "training": {
      "id": "training",
      "label": "Training mode",
      "badgeIcon": "graduation-cap",
      "showNavigator": true,
      "timerType": "count_up",
      "timerPosition": "navigator_header",
      "timeLockEnabled": false,
      "showHints": true,
      "showMarkCompleteButton": true,
      "allowTabClose": true
    },
    "practice": {
      "id": "practice",
      "label": "Practice mode",
      "badgeIcon": "dumbbell",
      "showNavigator": false,
      "timerType": "count_up",
      "timerPosition": "topbar",
      "timeLockEnabled": false,
      "showHints": false,
      "showMarkCompleteButton": false,
      "allowTabClose": true
    },
    "assessment": {
      "id": "assessment",
      "label": "Assessment Mode",
      "badgeIcon": "graduation-cap",
      "showNavigator": false,
      "timerType": "count_down",
      "timerPosition": "topbar_right",
      "timeLimitSeconds": 480,
      "timeLockEnabled": true,
      "showHints": false,
      "showMarkCompleteButton": false,
      "allowTabClose": false,
      "beforeUnloadWarning": "Assessment in progress. Leaving will lose your progress."
    }
  },
  "actions": {
    "validate_bypass": {
      "label": "Validate bypass code",
      "latencyMs": 400,
      "writes": {
        "eventResolution.bypassStatus": "Validated — PX_TF bypass applied"
      },
      "completesStepId": "step_011",
      "guard": {
        "dataKey": "eventResolution.bypassCode",
        "equals": "PX_TF",
        "elseWrites": {
          "eventResolution.bypassStatus": "Invalid bypass code — select PX_TF for Edit PX_MTF"
        }
      }
    }
  },
  "persistence": {
    "persistKey": null,
    "autosave": false,
    "resetOnSubmit": false
  }
}
