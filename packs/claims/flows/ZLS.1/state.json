{
  "$schema": "training-platform/v1/flow-state",
  "$version": "1.0.0",
  "id": "state_zls_1_vendor_pricing_returned_pay",
  "initial": {
    "defaultActiveTabId": "tab_event_resolution",
    "defaultActiveSubTabIds": {
      "tab_search": "subtab_search_benefits",
      "tab_claim_data": "subtab_claim_data_pricing",
      "tab_attachment": "subtab_attachment_attachments"
    },
    "defaultCollapsedSections": {},
    "defaultDecision": ""
  },
  "modeConfig": {
    "training": {
      "id": "training",
      "label": "Training mode",
      "badgeIcon": "graduation-cap",
      "showNavigator": true,
      "timerType": "count_up",
      "timerPosition": "navigator_header",
      "timeLockEnabled": false,
      "showHints": true,
      "showMarkCompleteButton": true,
      "allowTabClose": true
    },
    "practice": {
      "id": "practice",
      "label": "Practice mode",
      "badgeIcon": "dumbbell",
      "showNavigator": false,
      "timerType": "count_up",
      "timerPosition": "topbar",
      "timeLockEnabled": false,
      "showHints": false,
      "showMarkCompleteButton": false,
      "allowTabClose": true
    },
    "assessment": {
      "id": "assessment",
      "label": "Assessment Mode",
      "badgeIcon": "graduation-cap",
      "showNavigator": false,
      "timerType": "count_down",
      "timerPosition": "topbar_right",
      "timeLimitSeconds": 600,
      "timeLockEnabled": true,
      "showHints": false,
      "showMarkCompleteButton": false,
      "allowTabClose": false,
      "beforeUnloadWarning": "Assessment in progress. Leaving will lose your progress."
    }
  },
  "actions": {
    "validate": {
      "label": "Validate",
      "latencyMs": 400,
      "writes": {
        "eventResolution.validationMessage": "PX_ZLS RESOLVED — WRITE-OFF TYPE CODE PX_00ASC APPLIED TO LINE 1, WRITE-OFF $5.00"
      },
      "guard": {
        "all": [
          {
            "dataKey": "claimLineSummary.writeOffTypeCodeEntry",
            "equalsIgnoreCase": "PX_00ASC"
          }
        ],
        "elseWrites": {
          "eventResolution.validationMessage": "Claim not validated. Enter the write-off type code PX_00ASC on Claim Lines Line 1, then Validate again."
        }
      },
      "completesStepId": "step_006"
    }
  },
  "persistence": {
    "persistKey": null,
    "autosave": false,
    "resetOnSubmit": false
  }
}
