{
  "name": "@platform/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./src/env.ts",
      "default": "./dist/env.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./dist/schema.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./ids": {
      "types": "./src/ids.ts",
      "default": "./dist/ids.js"
    },
    "./seed": {
      "types": "./src/seed.ts",
      "default": "./dist/seed.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force",
    "db:seed": "tsx src/seed.ts",
    "dev:setup": "pnpm db:push && pnpm db:seed",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "tsx src/scripts/migrate.ts",
    "db:deploy": "tsx src/scripts/deploy.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "9.39.3",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "2.1.9",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.3",
    "globals": "17.3.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "2.1.9"
  }
}
