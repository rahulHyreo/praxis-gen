{
  "$schema": "training-platform/v1/flow-state",
  "$version": "1.0.0",
  "id": "state_280_1_newborn_within_enrolment_window_bypass_pay",
  "initial": {
    "defaultActiveTabId": "tab_event_resolution",
    "defaultActiveSubTabIds": {
      "tab_search": "subtab_search_benefits",
      "tab_claim_data": "subtab_claim_data_details",
      "tab_attachment": "subtab_attachment_attachments"
    },
    "defaultCollapsedSections": {},
    "defaultDecision": ""
  },
  "modeConfig": {
    "training": {
      "id": "training",
      "label": "Training mode",
      "badgeIcon": "graduation-cap",
      "showNavigator": true,
      "timerType": "count_up",
      "timerPosition": "navigator_header",
      "timeLockEnabled": false,
      "showHints": true,
      "showMarkCompleteButton": true,
      "allowTabClose": true
    },
    "practice": {
      "id": "practice",
      "label": "Practice mode",
      "badgeIcon": "dumbbell",
      "showNavigator": false,
      "timerType": "count_up",
      "timerPosition": "topbar",
      "timeLockEnabled": false,
      "showHints": false,
      "showMarkCompleteButton": false,
      "allowTabClose": true
    },
    "assessment": {
      "id": "assessment",
      "label": "Assessment Mode",
      "badgeIcon": "graduation-cap",
      "showNavigator": false,
      "timerType": "count_down",
      "timerPosition": "topbar_right",
      "timeLimitSeconds": 600,
      "timeLockEnabled": true,
      "showHints": false,
      "showMarkCompleteButton": false,
      "allowTabClose": false,
      "beforeUnloadWarning": "Assessment in progress. Leaving will lose your progress."
    }
  },
  "actions": {
    "validate": {
      "label": "Validate",
      "latencyMs": 400,
      "guard": {
        "dataKey": "eventResolution.bypassCode",
        "equals": "PX_GM",
        "elseWrites": {
          "eventResolution.bypassStatus": "Bypass code not accepted for this event — review the bypass code and select again",
          "eventResolution.validationMessage": ""
        }
      },
      "writes": {
        "eventResolution.bypassStatus": "Validated — bypass applied to PX_280",
        "eventResolution.validationMessage": "PX_280 BYPASSED — NEWBORN WITHIN THE STATE'S ENROLLMENT WINDOW"
      },
      "completesStepId": "step_009"
    },
    "search_member": {
      "label": "Search member",
      "latencyMs": 0,
      "writes": {}
    },
    "search_member_clear": {
      "label": "Clear member search",
      "latencyMs": 0,
      "writes": {}
    }
  },
  "persistence": {
    "persistKey": null,
    "autosave": false,
    "resetOnSubmit": false
  }
}
