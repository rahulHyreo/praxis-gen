# Local environment configuration (committed).
# Overrides base.env for a developer machine. APP_ENV defaults to `local`.
#
# EVERY CREDENTIAL BELOW IS A LOCALHOST-ONLY PLACEHOLDER. They exist so the
# containers can talk to each other and so `docker compose up` works on a fresh
# clone with no setup. They authenticate nothing beyond your machine, and they
# are deliberately obvious about it.
#
# A value that authenticates to a real external service — an API key, a cloud
# account key, an auth signing secret — NEVER goes in this file. It goes in
# ./.env, which is gitignored. This change introduces no such value: there is
# no email provider, no cloud storage account and no authentication yet.
# See ./README.md.

NODE_ENV=development

# ----- PostgreSQL -----
POSTGRES_USER=praxis2
POSTGRES_PASSWORD=local-only-not-a-secret
POSTGRES_DB=praxis2_local
# Host-side value, for a plain `pnpm dev` and for drizzle-kit on the host. The
# local overlay overrides this to the `postgres` service name inside the
# containers. Note the port: 5433, not v1's 5432 (see base.env).
DATABASE_URL=postgresql://praxis2:local-only-not-a-secret@localhost:5433/praxis2_local

# ----- Redis -----
# Host-side value, same pattern as DATABASE_URL. Comment it out to run with
# caching disabled — the api is a no-op without REDIS_URL, so nothing breaks.
REDIS_URL=redis://localhost:6380

# ----- Object storage (MinIO) -----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-only-not-a-secret
# Host-side endpoint, for scripts and for a browser opening a public object.
S3_PUBLIC_URL=http://localhost:9010

# ----- URLs -----
# The api binds 3001 and web 5173 when run on the HOST with `pnpm dev`; the
# containers publish 3002 and 5174 (see base.env). These name the host-process
# ports, which is what a browser and the CORS origin check see during ordinary
# development.
WEB_URL=http://localhost:5173
