# Honour the "packageManager" field in the root package.json.
#
# LOAD-BEARING, not a preference. package.json declares pnpm@11.5.0 (docs/SPEC.md
# §42), but pnpm 9 defaults this setting to false and so ignores that field
# entirely — a developer with pnpm 9 on PATH would silently resolve the whole
# dependency graph with the wrong package manager, and the declared version would
# be decorative. With this on, pnpm fetches and re-executes the declared version
# for every command in this repository, whatever is installed globally.
#
# pnpm 10 and later default this to true; the line is kept so a pnpm 9 host
# behaves identically.
manage-package-manager-versions=true

# No other overrides: the defaults are what this repository wants, and
# pnpm-workspace.yaml carries the two settings that do need stating (allowBuilds
# and the PGlite packageExtensions narrowing).
