    },
    "open_claim_review": {
      "label": "Open Request Claim Review",
      "latencyMs": 0,
      "writes": {},
      "completesStepId": "step_004"
    },
    "submit_cob_update": {
      "label": "Submit — Request COB Update",
      "latencyMs": 300,
      "guard": {
        "all": [
          {
            "dataKey": "claimReview.action",
            "equalsIgnoreCase": "Request COB Update"
          },
          {
            "dataKey": "claimReview.comments",
            "nonEmpty": true
          }
        ],
        "elseWrites": {
          "claimReview.submitStatus": "The request was not submitted. Select Request COB Update and enter Comments, then click Submit again."
        }
      },
      "writes": {
        "claimReview.submitStatus": "COB update request submitted. The claim is routed to the E-COB team to update the limited liability record."
      },
      "completesStepId": "step_006"
    }
  },
