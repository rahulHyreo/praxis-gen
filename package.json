{
  "name": "praxis",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test --concurrency=1 && pnpm test:root",
    "test:root": "vitest run --project root-tooling",
    "test:db": "turbo test:db",
    "db:push": "turbo db:push",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:migrate:run": "turbo db:migrate:run",
    "db:deploy": "turbo db:deploy",
    "db:seed": "turbo db:seed",
    "db:studio": "turbo db:studio",
    "dev:setup": "turbo dev:setup --filter=@platform/db",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.9",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.7.4",
    "turbo": "2.9.14",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20"
  }
}
